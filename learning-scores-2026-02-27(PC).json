    "The Alchemist||The Alchemist of Part 1-01": {
      "noteWords": {},
      "articleWords": {},
      "noteSentences": {},
      "articleSentences": {
        "There were no wolves in the region, but once an animal had strayed during the night, and the boy had had to spend the entire next day searching for it.": {
