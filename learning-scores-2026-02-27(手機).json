    "The Alchemist||The Alchemist of 1 Foreword": {
      "noteWords": {},
      "articleSentences": {
        "A man sets out on a journey, dreaming of a beautiful or magical place, in pursuit of some unknown treasure.": {
          "lastSeen": "2026/2/26",
          "wrong": 3,
          "firstSeen": "2026/2/25",
          "correct": 1,
          "reorder": {
            "wrong": 1,
            "correct": 0
